/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "soft-dawn-63ee",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"r2_buckets": [
		{
			"bucket_name": "ereader-library",
			"binding": "EREADER_BUCKET",
			"remote": true
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "EPUB_QUEUE",
				"queue": "ereader-epub-jobs"
			}
		],
		"consumers": [
			{
				"queue": "ereader-epub-jobs",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 3,
				"max_concurrency": 1
			}
		]
	},
	"images": {
		"binding": "IMAGES"
	}
}
